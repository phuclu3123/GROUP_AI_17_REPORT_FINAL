\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Broadcasting: nâng vector 1D thành ma trận 2D chênh lệch}
\PYG{n}{lat1} \PYG{o}{=} \PYG{n}{lats}\PYG{p}{[:,} \PYG{k+kc}{None}\PYG{p}{]}   \PYG{c+c1}{\PYGZsh{} shape (N, 1)}
\PYG{n}{lat2} \PYG{o}{=} \PYG{n}{lats}\PYG{p}{[}\PYG{k+kc}{None}\PYG{p}{,} \PYG{p}{:]}   \PYG{c+c1}{\PYGZsh{} shape (1, N)}
\PYG{n}{lon1} \PYG{o}{=} \PYG{n}{lons}\PYG{p}{[:,} \PYG{k+kc}{None}\PYG{p}{]}
\PYG{n}{lon2} \PYG{o}{=} \PYG{n}{lons}\PYG{p}{[}\PYG{k+kc}{None}\PYG{p}{,} \PYG{p}{:]}

\PYG{n}{dlat} \PYG{o}{=} \PYG{n}{lat2} \PYG{o}{\PYGZhy{}} \PYG{n}{lat1}     \PYG{c+c1}{\PYGZsh{} Ma trận chênh lệch vĩ độ}
\PYG{n}{dlon} \PYG{o}{=} \PYG{n}{lon2} \PYG{o}{\PYGZhy{}} \PYG{n}{lon1}     \PYG{c+c1}{\PYGZsh{} Ma trận chênh lệch kinh độ}

\PYG{c+c1}{\PYGZsh{} Thực thi Haversine đồng thời trên toàn bộ mảng (Vectorization)}
\PYG{n}{a} \PYG{o}{=} \PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{sin}\PYG{p}{(}\PYG{n}{dlat} \PYG{o}{/} \PYG{l+m+mi}{2}\PYG{p}{)} \PYG{o}{**} \PYG{l+m+mi}{2}
     \PYG{o}{+} \PYG{n}{np}\PYG{o}{.}\PYG{n}{cos}\PYG{p}{(}\PYG{n}{lat1}\PYG{p}{)} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{cos}\PYG{p}{(}\PYG{n}{lat2}\PYG{p}{)} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{sin}\PYG{p}{(}\PYG{n}{dlon} \PYG{o}{/} \PYG{l+m+mi}{2}\PYG{p}{)} \PYG{o}{**} \PYG{l+m+mi}{2}\PYG{p}{)}
\PYG{n}{c} \PYG{o}{=} \PYG{l+m+mi}{2} \PYG{o}{*} \PYG{n}{np}\PYG{o}{.}\PYG{n}{arcsin}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{np}\PYG{o}{.}\PYG{n}{clip}\PYG{p}{(}\PYG{n}{a}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1}\PYG{p}{)))}

\PYG{n}{R} \PYG{o}{=} \PYG{l+m+mf}{6371.0}  \PYG{c+c1}{\PYGZsh{} Bán kính Trái Đất (km)}
\PYG{n}{cost\PYGZus{}matrix} \PYG{o}{=} \PYG{n}{R} \PYG{o}{*} \PYG{n}{c}
\PYG{n}{np}\PYG{o}{.}\PYG{n}{fill\PYGZus{}diagonal}\PYG{p}{(}\PYG{n}{cost\PYGZus{}matrix}\PYG{p}{,} \PYG{l+m+mf}{0.0}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} Chi phí di chuyển tại chỗ bằng 0}
\end{MintedVerbatim}

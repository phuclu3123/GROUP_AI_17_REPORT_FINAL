\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{for} \PYG{n}{\PYGZus{}} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{pop\PYGZus{}size}\PYG{p}{):}
    \PYG{n}{genes} \PYG{o}{=} \PYG{n+nb}{list}\PYG{p}{(}\PYG{n}{non\PYGZus{}depot}\PYG{p}{)}
    \PYG{c+c1}{\PYGZsh{} Khởi tạo đa dạng Không gian Định tuyến (Routing)}
    \PYG{n}{random}\PYG{o}{.}\PYG{n}{shuffle}\PYG{p}{(}\PYG{n}{genes}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Ép breaks=None để kích hoạt cơ chế random.sample nội tại,}

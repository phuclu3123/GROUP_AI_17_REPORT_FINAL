\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{tournament\PYGZus{}selection}\PYG{p}{(}\PYG{n}{population}\PYG{p}{:} \PYG{n}{List}\PYG{p}{[}\PYG{n}{Chromosome}\PYG{p}{],}
                         \PYG{n}{tournament\PYGZus{}size}\PYG{p}{:} \PYG{n+nb}{int} \PYG{o}{=} \PYG{l+m+mi}{5}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Chromosome}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Tournament Selection (Rank\PYGZhy{}based): Không bị ảnh hưởng bởi độ chênh lệch}
\PYG{l+s+sd}{    fitness cực lớn.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{candidates} \PYG{o}{=} \PYG{n}{random}\PYG{o}{.}\PYG{n}{sample}\PYG{p}{(}\PYG{n}{population}\PYG{p}{,}
                               \PYG{n+nb}{min}\PYG{p}{(}\PYG{n}{tournament\PYGZus{}size}\PYG{p}{,}
                               \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{population}\PYG{p}{)))}
    \PYG{n}{winner} \PYG{o}{=} \PYG{n+nb}{max}\PYG{p}{(}\PYG{n}{candidates}\PYG{p}{,} \PYG{n}{key}\PYG{o}{=}\PYG{k}{lambda} \PYG{n}{c}\PYG{p}{:} \PYG{n}{c}\PYG{o}{.}\PYG{n}{fitness}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{winner}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{roulette\PYGZus{}wheel\PYGZus{}selection}\PYG{p}{(}\PYG{n}{population}\PYG{p}{:} \PYG{n}{List}\PYG{p}{[}\PYG{n}{Chromosome}\PYG{p}{])} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Chromosome}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Roulette Wheel Selection: Tỷ lệ thuận với fitness. Nhạy cảm với nhiễu do}
\PYG{l+s+sd}{    hàm phạt.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{total\PYGZus{}fitness} \PYG{o}{=} \PYG{n+nb}{sum}\PYG{p}{(}\PYG{n}{c}\PYG{o}{.}\PYG{n}{fitness} \PYG{k}{for} \PYG{n}{c} \PYG{o+ow}{in} \PYG{n}{population}\PYG{p}{)}
    \PYG{k}{if} \PYG{n}{total\PYGZus{}fitness} \PYG{o}{\PYGZlt{}=} \PYG{l+m+mi}{0}\PYG{p}{:}
        \PYG{k}{return} \PYG{n}{random}\PYG{o}{.}\PYG{n}{choice}\PYG{p}{(}\PYG{n}{population}\PYG{p}{)}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

    \PYG{n}{pick} \PYG{o}{=} \PYG{n}{random}\PYG{o}{.}\PYG{n}{uniform}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{n}{total\PYGZus{}fitness}\PYG{p}{)}
    \PYG{n}{cumulative} \PYG{o}{=} \PYG{l+m+mf}{0.0}
    \PYG{k}{for} \PYG{n}{chrom} \PYG{o+ow}{in} \PYG{n}{population}\PYG{p}{:}
        \PYG{n}{cumulative} \PYG{o}{+=} \PYG{n}{chrom}\PYG{o}{.}\PYG{n}{fitness}
        \PYG{k}{if} \PYG{n}{cumulative} \PYG{o}{\PYGZgt{}=} \PYG{n}{pick}\PYG{p}{:}
            \PYG{k}{return} \PYG{n}{chrom}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}
    \PYG{k}{return} \PYG{n}{population}\PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{select\PYGZus{}parents}\PYG{p}{(}
    \PYG{n}{population}\PYG{p}{:} \PYG{n}{List}\PYG{p}{[}\PYG{n}{Chromosome}\PYG{p}{],} \PYG{n}{count}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{tournament\PYGZus{}size}\PYG{p}{:} \PYG{n+nb}{int} \PYG{o}{=} \PYG{l+m+mi}{5}\PYG{p}{,}
    \PYG{n}{method}\PYG{p}{:} \PYG{n+nb}{str} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}tournament\PYGZdq{}}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{List}\PYG{p}{[}\PYG{n}{Chromosome}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Trích xuất `count` cha mẹ từ quần thể để chuẩn bị cho quá trình}
\PYG{l+s+sd}{    lai ghép.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{parents} \PYG{o}{=} \PYG{p}{[]}
    \PYG{k}{for} \PYG{n}{\PYGZus{}} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{count}\PYG{p}{):}
        \PYG{k}{if} \PYG{n}{method} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}roulette\PYGZdq{}}\PYG{p}{:}
            \PYG{n}{parents}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{roulette\PYGZus{}wheel\PYGZus{}selection}\PYG{p}{(}\PYG{n}{population}\PYG{p}{))}
        \PYG{k}{else}\PYG{p}{:}
            \PYG{n}{parents}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{tournament\PYGZus{}selection}\PYG{p}{(}\PYG{n}{population}\PYG{p}{,} \PYG{n}{tournament\PYGZus{}size}\PYG{p}{))}
    \PYG{k}{return} \PYG{n}{parents}
\end{MintedVerbatim}

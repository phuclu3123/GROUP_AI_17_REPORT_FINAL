\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{run\PYGZus{}ga}\PYG{p}{(}\PYG{n}{cities}\PYG{p}{,} \PYG{n}{depots}\PYG{p}{,} \PYG{n}{cost\PYGZus{}matrix}\PYG{p}{,} \PYG{n}{city\PYGZus{}index}\PYG{p}{,} \PYG{n}{config}\PYG{p}{,} \PYG{o}{...}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{GAResult}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Vòng lặp Tiến hóa AI cho bài toán VRP.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{population} \PYG{o}{=} \PYG{n}{create\PYGZus{}initial\PYGZus{}population}\PYG{p}{(}\PYG{o}{...}\PYG{p}{)}
    \PYG{n}{evaluate\PYGZus{}population}\PYG{p}{(}\PYG{n}{population}\PYG{p}{,} \PYG{o}{...}\PYG{p}{)}
    \PYG{n}{best} \PYG{o}{=} \PYG{n+nb}{min}\PYG{p}{(}\PYG{n}{population}\PYG{p}{,} \PYG{n}{key}\PYG{o}{=}\PYG{k}{lambda} \PYG{n}{c}\PYG{p}{:} \PYG{n}{c}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost}\PYG{p}{)}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

    \PYG{n}{history} \PYG{o}{=} \PYG{p}{[}\PYG{n}{best}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost}\PYG{p}{]}
    \PYG{n}{no\PYGZus{}improve\PYGZus{}count} \PYG{o}{=} \PYG{l+m+mi}{0}

    \PYG{k}{for} \PYG{n}{gen} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{config}\PYG{o}{.}\PYG{n}{num\PYGZus{}generations}\PYG{p}{):}
        \PYG{c+c1}{\PYGZsh{} 1. Elitism: Bảo tồn tinh hoa tuyệt đối}
        \PYG{n}{elites} \PYG{o}{=} \PYG{p}{[}
            \PYG{n}{e}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()} \PYG{k}{for} \PYG{n}{e} \PYG{o+ow}{in} \PYG{n+nb}{sorted}\PYG{p}{(}
                \PYG{n}{population}\PYG{p}{,} \PYG{n}{key}\PYG{o}{=}\PYG{k}{lambda} \PYG{n}{c}\PYG{p}{:} \PYG{n}{c}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost}
            \PYG{p}{)[:}\PYG{n}{config}\PYG{o}{.}\PYG{n}{elitism\PYGZus{}k}\PYG{p}{]}
        \PYG{p}{]}

        \PYG{c+c1}{\PYGZsh{} 2. Chọn lọc \PYGZam{} Lai ghép: tạo tập Offspring từ Tournament Selection}
        \PYG{n}{parents} \PYG{o}{=} \PYG{n}{select\PYGZus{}parents}\PYG{p}{(}
            \PYG{n}{population}\PYG{p}{,}
            \PYG{n}{count}\PYG{o}{=}\PYG{n}{config}\PYG{o}{.}\PYG{n}{pop\PYGZus{}size}\PYG{p}{,}
            \PYG{n}{tournament\PYGZus{}size}\PYG{o}{=}\PYG{n}{config}\PYG{o}{.}\PYG{n}{tournament\PYGZus{}size}\PYG{p}{,}
            \PYG{n}{method}\PYG{o}{=}\PYG{n}{config}\PYG{o}{.}\PYG{n}{selection\PYGZus{}method}
        \PYG{p}{)}
        \PYG{n}{offspring} \PYG{o}{=} \PYG{n}{crossover\PYGZus{}population}\PYG{p}{(}\PYG{n}{parents}\PYG{p}{,} \PYG{n}{config}\PYG{o}{.}\PYG{n}{crossover\PYGZus{}rate}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} 3. Đột biến kép: Gene Mutation + Break Mutation (gọi \PYGZus{}invalidate() nội tại)}
        \PYG{n}{offspring} \PYG{o}{=} \PYG{n}{mutate\PYGZus{}population}\PYG{p}{(}
            \PYG{n}{offspring}\PYG{p}{,}
            \PYG{n}{config}\PYG{o}{.}\PYG{n}{mutation\PYGZus{}rate}\PYG{p}{,}
            \PYG{n}{config}\PYG{o}{.}\PYG{n}{break\PYGZus{}mutation\PYGZus{}rate}
        \PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} 4. Hợp nhất đa nguồn: Tinh hoa (giữ nguyên cost) → Lai tạo (cost = inf)}
        \PYG{n}{new\PYGZus{}population} \PYG{o}{=} \PYG{n}{elites} \PYG{o}{+} \PYG{n}{offspring}
        \PYG{c+c1}{\PYGZsh{} Bổ sung thêm cá thể nếu quần thể chưa đủ kích thước N}
        \PYG{k}{while} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{new\PYGZus{}population}\PYG{p}{)} \PYG{o}{\PYGZlt{}} \PYG{n}{config}\PYG{o}{.}\PYG{n}{pop\PYGZus{}size}\PYG{p}{:}
            \PYG{n}{extra} \PYG{o}{=} \PYG{n}{select\PYGZus{}parents}\PYG{p}{(}
                \PYG{n}{population}\PYG{p}{,} \PYG{n}{count}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,}
                \PYG{n}{tournament\PYGZus{}size}\PYG{o}{=}\PYG{n}{config}\PYG{o}{.}\PYG{n}{tournament\PYGZus{}size}\PYG{p}{,}
                \PYG{n}{method}\PYG{o}{=}\PYG{n}{config}\PYG{o}{.}\PYG{n}{selection\PYGZus{}method}
            \PYG{p}{)[}\PYG{l+m+mi}{0}\PYG{p}{]}
            \PYG{n}{new\PYGZus{}population}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{extra}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} 5. Đánh giá lười (Lazy Evaluation): chỉ tái tính cá thể bị \PYGZus{}invalidate()}
        \PYG{n}{unevaluated} \PYG{o}{=} \PYG{p}{[}
            \PYG{n}{c} \PYG{k}{for} \PYG{n}{c} \PYG{o+ow}{in} \PYG{n}{new\PYGZus{}population} \PYG{k}{if} \PYG{n}{c}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost} \PYG{o}{==} \PYG{n+nb}{float}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}inf\PYGZdq{}}\PYG{p}{)}
        \PYG{p}{]}
        \PYG{n}{evaluate\PYGZus{}population}\PYG{p}{(}\PYG{n}{unevaluated}\PYG{p}{,} \PYG{o}{...}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} 6. Cắt tỉa (Truncation): giữ lại đúng N cá thể ưu tú nhất}
        \PYG{n}{population} \PYG{o}{=} \PYG{n+nb}{sorted}\PYG{p}{(}
            \PYG{n}{new\PYGZus{}population}\PYG{p}{,} \PYG{n}{key}\PYG{o}{=}\PYG{k}{lambda} \PYG{n}{c}\PYG{p}{:} \PYG{n}{c}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost}
        \PYG{p}{)[:}\PYG{n}{config}\PYG{o}{.}\PYG{n}{pop\PYGZus{}size}\PYG{p}{]}

        \PYG{c+c1}{\PYGZsh{} 6. Khống chế Hội tụ (Early Stopping)}
        \PYG{n}{gen\PYGZus{}best} \PYG{o}{=} \PYG{n+nb}{min}\PYG{p}{(}\PYG{n}{population}\PYG{p}{,} \PYG{n}{key}\PYG{o}{=}\PYG{k}{lambda} \PYG{n}{c}\PYG{p}{:} \PYG{n}{c}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost}\PYG{p}{)}
        \PYG{k}{if} \PYG{n}{gen\PYGZus{}best}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost} \PYG{o}{\PYGZlt{}} \PYG{n}{best}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost}\PYG{p}{:}
            \PYG{n}{best} \PYG{o}{=} \PYG{n}{gen\PYGZus{}best}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}
            \PYG{n}{no\PYGZus{}improve\PYGZus{}count} \PYG{o}{=} \PYG{l+m+mi}{0}
        \PYG{k}{else}\PYG{p}{:}
            \PYG{n}{no\PYGZus{}improve\PYGZus{}count} \PYG{o}{+=} \PYG{l+m+mi}{1}

        \PYG{n}{history}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{best}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost}\PYG{p}{)}

        \PYG{k}{if} \PYG{n}{no\PYGZus{}improve\PYGZus{}count} \PYG{o}{\PYGZgt{}=} \PYG{n}{config}\PYG{o}{.}\PYG{n}{patience}\PYG{p}{:}
            \PYG{k}{break} \PYG{c+c1}{\PYGZsh{} Bão hòa \PYGZhy{}\PYGZgt{} Dừng tìm kiếm}

    \PYG{k}{return} \PYG{n}{GAResult}\PYG{p}{(}
        \PYG{n}{best\PYGZus{}chromosome}\PYG{o}{=}\PYG{n}{best}\PYG{p}{,}
        \PYG{n}{best\PYGZus{}cost}\PYG{o}{=}\PYG{n}{best}\PYG{o}{.}\PYG{n}{total\PYGZus{}cost}\PYG{p}{,}
        \PYG{n}{history}\PYG{o}{=}\PYG{n}{history}\PYG{p}{)}
\end{MintedVerbatim}

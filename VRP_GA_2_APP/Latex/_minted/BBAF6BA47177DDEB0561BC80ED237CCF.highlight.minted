\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Capacity Penalty}
\PYG{k}{if} \PYG{n}{route\PYGZus{}demand} \PYG{o}{\PYGZgt{}} \PYG{n}{max\PYGZus{}capacity}\PYG{p}{:}
    \PYG{n}{overflow} \PYG{o}{=} \PYG{n}{route\PYGZus{}demand} \PYG{o}{\PYGZhy{}} \PYG{n}{max\PYGZus{}capacity}

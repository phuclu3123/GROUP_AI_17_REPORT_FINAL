        \PYG{n}{ready}\PYG{p}{,} \PYG{n}{due} \PYG{o}{=} \PYG{n}{time\PYGZus{}windows}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{n}{c2}\PYG{p}{,} \PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+m+mi}{1440}\PYG{p}{))}

